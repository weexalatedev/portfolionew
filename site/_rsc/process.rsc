15:T4a9,{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://tashfeen.me/#person","name":"Tashfeen Ahmed","url":"https://tashfeen.me","image":"https://tashfeen.me/featured-square.png","jobTitle":"AI Product Designer","worksFor":{"@type":"Organization","name":"Microsoft","url":"https://www.microsoft.com"},"alumniOf":{"@type":"CollegeOrUniversity","name":"University of Edinburgh","url":"https://www.ed.ac.uk"},"award":"Awwwards Honorable Mention, January 14 2026","subjectOf":{"@type":"CreativeWork","name":"Awwwards Honorable Mention, January 14 2026","url":"https://www.awwwards.com/sites/tash","datePublished":"2026-01-14"},"knowsAbout":["Agentic Systems","Human-in-the-Loop Design","Microsoft 365 Copilot","Human-AI Interaction","Product Design","Data Visualization","Writing Assistance","Creative Coding"],"sameAs":["https://github.com/tashfeenahmed","https://www.linkedin.com/in/tashfeen/","https://x.com/tashfene","https://www.awwwards.com/sites/tash"]},{"@type":"WebSite","@id":"https://tashfeen.me/#website","name":"Tashfeen Ahmed Portfolio","url":"https://tashfeen.me","publisher":{"@id":"https://tashfeen.me/#person"},"about":{"@id":"https://tashfeen.me/#person"}}]}b:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}]
