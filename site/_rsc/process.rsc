1e:["$","ul",null,{"className":"prose-page__list","children":[["$","li","/#copilot-intro",{"children":[["$","a",null,{"href":"/#copilot-intro","children":"Microsoft Copilot"}],["$","p",null,{"className":"prose-page__source","children":"Agentic drafting, summarizing, rewriting and editing in Word."}]]}],["$","li","/#agent-mode-intro",{"children":[["$","a",null,{"href":"/#agent-mode-intro","children":"Agent Mode"}],["$","p",null,{"className":"prose-page__source","children":"Early design exploration of the agentic loop in Word, Excel and PowerPoint."}]]}],["$","li","/#freellmapi-intro",{"children":[["$","a",null,{"href":"/#freellmapi-intro","children":"FreeLLMAPI"}],["$","p",null,{"className":"prose-page__source","children":"An open-source router that stacks every free AI tier behind one endpoint."}]]}],["$","li","/#user-evaluation-intro",{"children":[["$","a",null,{"href":"/#user-evaluation-intro","children":"User Evaluation"}],["$","p",null,{"className":"prose-page__source","children":"An AI-native platform for customer understanding at scale."}]]}],["$","li","/#keeptruckin-intro",{"children":[["$","a",null,{"href":"/#keeptruckin-intro","children":"Motive / KeepTruckin"}],["$","p",null,{"className":"prose-page__source","children":"A self-service developer platform for fleet management integrations."}]]}],["$","li","/#makerarm-intro",{"children":[["$","a",null,{"href":"/#makerarm-intro","children":"Makerarm"}],["$","p",null,{"className":"prose-page__source","children":"A browser-based control interface for a desktop fabrication system."}]]}],["$","li","/#fidget-digits-intro",{"children":[["$","a",null,{"href":"/#fidget-digits-intro","children":"Fidget Digits"}],["$","p",null,{"className":"prose-page__source","children":"A self-tracking device for fidgeting during online lectures."}]]}],["$","li","/#pyreality-intro",{"children":[["$","a",null,{"href":"/#pyreality-intro","children":"pyReality"}],["$","p",null,{"className":"prose-page__source","children":"Mixed reality data visualization inside Jupyter Notebooks."}]]}],["$","li","/#expressive-lamp-intro",{"children":[["$","a",null,{"href":"/#expressive-lamp-intro","children":"Expressive light lamp"}],["$","p",null,{"className":"prose-page__source","children":"A subtle physical-distancing aid for shared student spaces."}]]}],["$","li","/#midi-controller-intro",{"children":[["$","a",null,{"href":"/#midi-controller-intro","children":"MIDI Controller"}],["$","p",null,{"className":"prose-page__source","children":"A custom Arduino controller for three-deck mixing."}]]}]]}]
