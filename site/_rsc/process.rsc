16:["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#keeptruckin-introMotive / KeepTruckin",{"children":[false,["$","a",null,{"href":"/#keeptruckin-intro","children":"Motive / KeepTruckin"}]]}],["$","span","/#fidget-digits-introFidget Digits",{"children":[", ",["$","a",null,{"href":"/#fidget-digits-intro","children":"Fidget Digits"}]]}]]]}]
17:["$","li","Prototype how it feels, then iterate fast",{"children":[["$","h2",null,{"children":"Prototype how it feels, then iterate fast"}],["$","p",null,{"children":"For Agent Mode, the agentic loop in Word, Excel and PowerPoint, I prototyped interactions early to work out how autonomous capabilities would feel, iterated rapidly on concepts, and used what I found to help establish the direction. Fidget Digits went from sketches discussed with students to Rhino models to 3D prints that we could evaluate in the hand. The MIDI controller was tuned during rehearsals, adjusting mappings, response times and LED feedback. An agent has timing in it, so the prototype has to run, not just look right."}],["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#agent-mode-introAgent Mode",{"children":[false,["$","a",null,{"href":"/#agent-mode-intro","children":"Agent Mode"}]]}],["$","span","/#fidget-digits-introFidget Digits",{"children":[", ",["$","a",null,{"href":"/#fidget-digits-intro","children":"Fidget Digits"}]]}],["$","span","/#midi-controller-introMIDI Controller",{"children":[", ",["$","a",null,{"href":"/#midi-controller-intro","children":"MIDI Controller"}]]}]]]}]]}]
18:["$","li","Bring product and engineering in early",{"children":[["$","h2",null,{"children":"Bring product and engineering in early"}],["$","p",null,{"children":"On KeepTruckin I collaborated closely with product managers and engineers from the start of the UX process so that technical feasibility and user needs stayed aligned. At User Evaluation I also took on a product management role, shaping the vision and requirements for transcription, AI insights and multimodal chat, and aligning each feature with the business objectives. Constraints found early are design material; constraints found late are rework."}],["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#keeptruckin-introMotive / KeepTruckin",{"children":[false,["$","a",null,{"href":"/#keeptruckin-intro","children":"Motive / KeepTruckin"}]]}],["$","span","/#user-evaluation-introUser Evaluation",{"children":[", ",["$","a",null,{"href":"/#user-evaluation-intro","children":"User Evaluation"}]]}]]]}]]}]
19:["$","li","Design the new pattern, not just the screen",{"children":[["$","h2",null,{"children":"Design the new pattern, not just the screen"}],["$","p",null,{"children":"Bringing transformer-based language models into Word meant designing new patterns and interactions, including tailored suggestions and proactive text transformations, rather than fitting AI into existing controls. Makerarm’s software did the same for fabrication: a smart tool detection system adjusted the interface to whatever head was attached, and a teaching mode let people train the arm by demonstration. When the system can act on its own, the pattern for how it proposes, shows its work and hands control back is the product."}],["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#copilot-introMicrosoft Copilot",{"children":[false,["$","a",null,{"href":"/#copilot-intro","children":"Microsoft Copilot"}]]}],["$","span","/#makerarm-introMakerarm",{"children":[", ",["$","a",null,{"href":"/#makerarm-intro","children":"Makerarm"}]]}]]]}]]}]
1a:["$","li","Empower, not overpower",{"children":[["$","h2",null,{"children":"Empower, not overpower"}],["$","p",null,{"children":"My design ethos is that technology should empower, not overpower, enhancing human experiences without overshadowing them. The expressive light lamp for shared study spaces was non-authoritative, non-invasive and subtle by design, and built so it never resembled a surveillance tool. Fidget Digits was meant to make students more self-aware without distracting them. For an agent, this is the line between a feature people keep and one they switch off."}],["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#current-practiceCurrent practice",{"children":[false,["$","a",null,{"href":"/#current-practice","children":"Current practice"}]]}],["$","span","/#expressive-lamp-introExpressive light lamp",{"children":[", ",["$","a",null,{"href":"/#expressive-lamp-intro","children":"Expressive light lamp"}]]}],["$","span","/#fidget-digits-introFidget Digits",{"children":[", ",["$","a",null,{"href":"/#fidget-digits-intro","children":"Fidget Digits"}]]}]]]}]]}]
1b:["$","li","Evaluate in real use, revise, and share what you learn",{"children":[["$","h2",null,{"children":"Evaluate in real use, revise, and share what you learn"}],["$","p",null,{"children":"Usability testing of the lamp showed it changed behaviour and also showed habituation, which pointed to the next iteration. Fidget Digits was revised after evaluation because the first prototype favoured function over ergonomics. On Agent Mode, sharing findings with the broader team informed key research decisions."}],["$","p",null,{"className":"prose-page__source","children":["From:"," ",[["$","span","/#expressive-lamp-introExpressive light lamp",{"children":[false,["$","a",null,{"href":"/#expressive-lamp-intro","children":"Expressive light lamp"}]]}],["$","span","/#fidget-digits-introFidget Digits",{"children":[", ",["$","a",null,{"href":"/#fidget-digits-intro","children":"Fidget Digits"}]]}],["$","span","/#agent-mode-introAgent Mode",{"children":[", ",["$","a",null,{"href":"/#agent-mode-intro","children":"Agent Mode"}]]}]]]}]]}]
