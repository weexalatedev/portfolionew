2:T697,
              (function() {
                try {
                  var storageKey = 'theme';
                  var classNameDark = 'dark';
                  var classNameLight = 'light';
                  
                  function setClassOnDocumentBody(darkMode) {
                    var d = document.documentElement;
                    d.classList.remove(classNameLight);
                    d.classList.remove(classNameDark);
                    d.classList.add(darkMode ? classNameDark : classNameLight);
                    d.style.colorScheme = darkMode ? 'dark' : 'light';
                  }
                  
                  var localStorageTheme = null;
                  try {
                    localStorageTheme = localStorage.getItem(storageKey);
                  } catch (err) {}
                  
                  var localStorageExists = localStorageTheme !== null;
                  if (localStorageExists) {
                    localStorageTheme = JSON.parse(JSON.stringify(localStorageTheme));
                  }
                  
                  if (localStorageExists) {
                    if (localStorageTheme === 'system') {
                      var mql = window.matchMedia('(prefers-color-scheme: dark)');
                      setClassOnDocumentBody(mql.matches);
                    } else {
                      setClassOnDocumentBody(localStorageTheme === 'dark');
                    }
                  } else {
                    var mql = window.matchMedia('(prefers-color-scheme: dark)');
                    setClassOnDocumentBody(mql.matches);
                  }
                } catch (err) {}
              })();
